<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Welcome Section - Green Theme -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/pharmacist_green">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/pharmacist_welcome_background">

                <TextView
                    android:id="@+id/welcomeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to Pharmacist Dashboard"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:letterSpacing="0.02" />

                <TextView
                    android:id="@+id/subtitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Manage medications and ensure patient safety"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A"
                    android:alpha="0.8" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Pharmacy Stats Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pharmacy Overview"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:letterSpacing="0.01" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/statsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:nestedScrollingEnabled="false" />

        <!-- Quick Actions Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quick Actions"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:letterSpacing="0.01" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Dispensing Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dispensingButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Dispense Medication"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:letterSpacing="0.01"
                    app:icon="@drawable/ic_medication_dispensing"
                    app:iconGravity="textStart"
                    app:iconTint="#1A1A1A"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/pharmacist_green"
                    app:elevation="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Inventory Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/inventoryButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Check Inventory"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:letterSpacing="0.01"
                    app:icon="@drawable/ic_inventory"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/pharmacist_green"
                    app:elevation="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Disposed Medicine Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/interactionsButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Disposed Medicine"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:letterSpacing="0.01"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/pharmacist_green"
                    app:elevation="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Verify Prescription Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/verificationButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Verify Prescription"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:letterSpacing="0.01"
                    app:icon="@drawable/ic_prescription_verification"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/pharmacist_green"
                    app:elevation="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Profile Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profileButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Pharmacist Profile"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:letterSpacing="0.01"
                    app:icon="@drawable/ic_doctor_profile"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/pharmacist_green"
                    app:elevation="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Reports Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reportsButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Pharmacy Reports"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:letterSpacing="0.01"
                    app:icon="@drawable/ic_analytics"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/pharmacist_green"
                    app:elevation="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
