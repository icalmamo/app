<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_border_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Patient Name -->
        <TextView
            android:id="@+id/historyPatientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <!-- Medication -->
        <TextView
            android:id="@+id/historyMedication"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medication: Paracetamol"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <!-- Frequency -->
        <TextView
            android:id="@+id/historyFrequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frequency: 3 times daily"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <!-- Duration -->
        <TextView
            android:id="@+id/historyDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duration: 7 days"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <!-- Doctor -->
        <TextView
            android:id="@+id/historyDoctorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doctor: Dr. John Smith"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <!-- Deducted Amount -->
        <TextView
            android:id="@+id/historyDeducted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deducted from Inventory: 21 units"
            android:textSize="14sp"
            android:textColor="@color/success_green"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Date -->
        <TextView
            android:id="@+id/historyDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dispensed: 2025-12-05 15:20:44"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textStyle="italic" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

